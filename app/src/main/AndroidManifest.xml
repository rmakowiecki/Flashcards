<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission
    android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
    android:minSdkVersion="34" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- The portrait lock below would otherwise make Play require a portrait screen; large screens
       are unlocked and run in any orientation (ADR-0074). -->
  <uses-feature
    android:name="android.hardware.screen.portrait"
    android:required="false" />

  <application
    android:name=".FlashcardsApplication"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.Flashcards">
    <!-- Portrait locks a phone before its first frame; lockPortraitOnPhones() in onCreate unlocks
         large screens (ADR-0074), so lint's large-screen orientation warnings don't apply. -->
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:screenOrientation="portrait"
      android:theme="@style/Theme.Flashcards.Starting"
      tools:ignore="DiscouragedApi,LockedOrientationActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- WorkManager's own androidx.startup auto-initializer is removed here because
         FlashcardsApplication implements Configuration.Provider (Hilt-backed WorkerFactory) —
         leaving both active throws "WorkManager is already initialized". Only WorkManager's own
         meta-data child is removed; the provider itself is shared with emoji2,
         ProcessLifecycleInitializer and profileinstaller, so it stays, merged. -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>

  </application>
</manifest>
