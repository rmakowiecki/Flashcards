<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Lets Android Studio's profiler and Perfetto attach without making the build debuggable. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!-- Profiling compiles src/debug/java, so the debug hub's activities are registered here too. -->
        <!-- Portrait on phones only; lockPortraitOnPhones() unlocks large screens (ADR-0074). -->
        <activity
            android:name=".presentation.debug.CardAnimationsDebugActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Flashcards"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".presentation.showcase.ScreenShowcaseActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>
</manifest>
