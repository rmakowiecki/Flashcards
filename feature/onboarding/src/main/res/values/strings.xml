    <string name="mastery_xp_reward_label">+%1$d XP</string>
    <string name="mastery_xp_banner_message">Every mastered card earns XP — climb Levels and track progress per topic in the Progress tab.</string>

    <!-- 4 · Session modes -->
    <string name="session_modes_eyebrow_label">Two study session modes</string>
    <string name="session_modes_headline_title">Pick your studying mode</string>
    <string name="session_modes_intro_message">Choose your mode each time you start. Pick your default below — change it anytime in Settings.</string>
    <string name="session_modes_rated_title">Rated</string>
    <string name="session_modes_rated_message">Reveal each answer, then rate yourself — or speak your answer and let the app grade it automatically. Progress is saved.</string>
    <string name="session_modes_fast_title">Fast</string>
    <string name="session_modes_fast_message">Move through cards at your pace — tap to reveal the answer and advance, or turn on read-aloud to go hands-free.</string>
    <string name="session_modes_hands_free_banner_message">Both modes can go hands-free — turn on read-aloud in Fast, or Voice Answering in Rated. Great for a walk or commute.</string>

