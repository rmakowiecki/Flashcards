              "subcategoryId": "sub-1",
              "state": "Mastered",
              "wasPreviouslyMastered": true
            },
            {
              "cardId": "card-2",
              "subcategoryId": "sub-2",
              "state": "Mastered",
              "wasPreviouslyMastered": false
            }
          ]
        }
      },
      "expected": {
