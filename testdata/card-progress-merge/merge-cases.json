          "sub-2": {
            "card-2": {
              "state": "Mastered",
              "stampFirstStudied": true,
              "stampMastered": true
            }
          }
        },
        "summaryDeltas": {
          "sub-2": {
            "masteredDelta": 1,
            "studiedDelta": 1
          }
        },
        "newCardsStudied": 1,
        "previouslyMastered": {
          "card-1": true,
          "card-2": false
        }
      }
