            }
          }
        },
        "summaryDeltas": {
          "sub-1": {
            "masteredDelta": 0,
            "studiedDelta": 1
          }
        },
        "newCardsStudied": 1,
        "previouslyMastered": {
          "card-1": false
        }
      }
    },
