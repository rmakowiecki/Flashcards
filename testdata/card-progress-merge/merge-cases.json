    {
      "name": "a session over two Subcategories merges each against its own prior record and omits unchanged counts",
      "input": {
        "priorCards": {
          "sub-1": {
            "card-1": "Mastered",
            "card-2": "Failed"
          },
          "sub-2": {
            "card-3": "Mastered"
          }
        },
        "session": {
          "studyMode": "Rated",
          "cardResults": [
            {
              "cardId": "card-1",
              "subcategoryId": "sub-1",
              "state": "Partial",
              "wasPreviouslyMastered": true
            },
            {
              "cardId": "card-2",
              "subcategoryId": "sub-1",
              "state": "Mastered",
              "wasPreviouslyMastered": false
            },
            {
              "cardId": "card-4",
              "subcategoryId": "sub-1",
              "state": "Failed",
              "wasPreviouslyMastered": false
            },
            {
              "cardId": "card-3",
              "subcategoryId": "sub-2",
              "state": "Mastered",
              "wasPreviouslyMastered": true
            },
            {
              "cardId": "card-5",
              "subcategoryId": "sub-2",
              "state": "Partial",
              "wasPreviouslyMastered": false
            }
          ]
        }
      },
      "expected": {
        "cardUpdates": {
          "sub-1": {
            "card-2": {
              "state": "Mastered",
              "stampFirstStudied": false,
              "stampMastered": true
            },
            "card-4": {
              "state": "Failed",
              "stampFirstStudied": true,
              "stampMastered": false
            }
          },
          "sub-2": {
            "card-5": {
              "state": "Partial",
              "stampFirstStudied": true,
              "stampMastered": false
            }
          }
        },
        "summaryDeltas": {
          "sub-1": {
            "masteredDelta": 1,
            "studiedDelta": 1
          },
          "sub-2": {
            "masteredDelta": 0,
            "studiedDelta": 1
          }
        },
        "newCardsStudied": 2,
        "previouslyMastered": {
          "card-1": true,
          "card-2": false,
          "card-4": false,
          "card-3": true,
          "card-5": false
        }
      }
    },
    {
      "name": "a Subcategory whose cards all stay as they were has no summary delta",
      "input": {
        "priorCards": {
          "sub-1": {
            "card-1": "Mastered"
