{
  "description": "Shared Card Progress merge cases, run by both the TypeScript submitStudySession merge module and the Kotlin mergeSessionIntoCardProgress. See README.md in this directory for the schema.",
  "cases": [
    {
      "name": "a Rated card with no record that ends Mastered is written Mastered, stamped both times and counted new",
      "input": {
        "priorCards": {},
        "session": {
          "studyMode": "Rated",
          "cardResults": [
            {
              "cardId": "card-1",
              "subcategoryId": "sub-1",
              "state": "Mastered",
              "wasPreviouslyMastered": false
            }
          ]
        }
      },
      "expected": {
        "cardUpdates": {
          "sub-1": {
            "card-1": {
              "state": "Mastered",
              "stampFirstStudied": true,
              "stampMastered": true
            }
          }
        },
        "summaryDeltas": {
          "sub-1": {
            "masteredDelta": 1,
            "studiedDelta": 1
          }
        },
        "newCardsStudied": 1,
        "previouslyMastered": {
          "card-1": false
        }
      }
    },
    {
      "name": "a Rated card with no record that ends Partial is written Partial and counted new",
