*.aab

# Firebase config — not committed for public repos. Each dev/CI provides their own.
app/google-services.json

# Firestore seeding — local temp fixtures and service-account creds, never committed
scripts/seed/.tmp/
scripts/seed/.venv/
**/*service-account*.json
**/*.cred.json

# Knowledge graph — generated locally, not committed
graphify-out/

# Claude Code local state — only the shared project skills are committed
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/compose-stability/
!.claude/skills/distribute-wip/

# Raw docs, sources for generating the flashcards
/docs/temp/
/docs/android/
.scratch

# Kotlin language reference docs — local working material, not committed
/docs/kotlin/

# Python language reference docs — local working material, not committed
/docs/python/
/docs/scientific-python/

# Swift language reference docs — local working material, not committed
/docs/swift/
/docs/apple-platforms

# Python bytecode cache
scripts/__pycache__/

# core:voice module build output
core/voice/build/

# core:common module build output
core/common/build/

# Firebase Cloud Functions
functions/node_modules/
functions/lib/

# Firestore rules tests
firestore-tests/node_modules/

# Firebase emulator run artifacts
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
