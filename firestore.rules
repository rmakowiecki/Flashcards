rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // meta/seed (ADR-0039) is the cache-generation freshness signal: a monotonic int
    // bumped by seed_firestore.py at the end of every import run. Read-only to clients,
    // same as categories/subcategories/shards below — written only by the Admin SDK.
    match /meta/seed {
      allow read: if request.auth != null;
    }

    // categories/subcategories/shards (flashcard content) are curated shared
    // content with no owner field; clients may read but only the Admin SDK
    // (which bypasses these rules) may write.
    match /categories/{categoryId} {
      allow read: if request.auth != null;
    }

    match /subcategories/{subcategoryId} {
      allow read: if request.auth != null;

      // Cards are packed into byte-budgeted shard docs, not one doc per card
      // (ADR-0037) — the collection is named `shards`, not `flashcards`.
      match /shards/{shardId} {
        allow read: if request.auth != null;
      }
    }

    match /users/{uid} {
      match /curationRequests/{requestId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // favorites/state (single-document design, see firestore-schema.md): one document holds both
      // category and subcategory favorites as id -> serverTimestamp maps, so one rule covers both.
      // Client-writable directly, same reasoning as curationRequests above — favorites are
      // non-sensitive by design, no Cloud Function gating needed.
      match /favorites/state {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // sessions/{sessionId} (ADR-0014, ADR-0049): one document per finished Study
      // Session. Client-read-only — the server-authoritative `submitStudySession` Cloud Function
      // (Admin SDK, bypasses these rules) is now the sole writer, so no client write of any kind
      // (create, update or delete) is allowed here anymore, closing CR-69 #6 (duplicate-sessionId
      // re-commit) at the source: there is no client-driven write path left to retry.
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      // progress/{docId} (ADR-0016, ADR-0049): per-user singleton documents — the
      // progress summary (progress/summary) and the scoring state (progress/user-stats) both
      // live in this collection, so this one rule covers both without a further change.
      // progress/details is a fixed anchor document with no fields of its own; its rule below
      // covers the real subcollection it hosts. Client-read-only, same reasoning as
      // sessions/{sessionId} above — the CR-69 #4 self-forged-progress concern this rule's history
      // once accepted is now moot: there is no client write path left to forge through.
      match /progress/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      // progress/details/subcategories/{subcategoryId} (ADR-0016, ADR-0049): one packed
      // document per Subcategory, holding every card the User has studied in it. Written as part
      // of the same session-commit the `submitStudySession` function performs server-side.
      // Client-read-only, same reasoning as sessions/{sessionId} above.
      match /progress/details/subcategories/{subcategoryId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      // entitlement: intentionally no rule here -> default deny.
      // Only the Cloud Function (Admin SDK) may read/write it.
    }
  }
}
